# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Validation
MAX_MESSAGE_LENGTH=8000
MAX_SESSION_TITLE_LENGTH=255
MAX_DOCUMENT_CONTENT_LENGTH=2000000
MAX_DATASET_BYTES=25000000

# CORS
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000

# Shared local coding/Git tools. Keep disabled for multi-user deployments until
# each workspace has its own filesystem root.
ENABLE_WORKSPACE_TOOLS=false
# Optional local-only repository root. Leave blank for per-workspace sandboxes.
WORKSPACE_TOOLS_ROOT=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Set this privately in backend/.env; it is intentionally blank here.
ADMIN_EMAIL=
MONTHLY_TOKEN_LIMIT=100000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40

# System Prompt
SYSTEM_PROMPT=You are Melo-AI, a helpful local AI assistant. You provide accurate, thoughtful responses while respecting user privacy. You run entirely on the user's local machine.

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=melo_documents
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT=30
QDRANT_ENABLED=true
QDRANT_SCORE_THRESHOLD=0.25

# Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Database Configuration
# Authentication secret (use a long random value in backend/.env)
MELO_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# For development: SQLite (default)
DATABASE_URL=sqlite:///./melo_ai.db

# For PostgreSQL on Windows/local dev
# Use the binary-friendly driver for Python 3.13+ on Windows
# DATABASE_URL=postgresql+psycopg://postgres:****@localhost:5432/melo_ai

# Debug SQL queries (show SQL in logs)
DEBUG_SQL=false
