# Copy to production.env outside version control and replace every value.
PUBLIC_DOMAIN=your-domain.example
PUBLIC_API_URL=/api
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend application settings
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
AUTH_COOKIE_SECURE=true
ENABLE_HSTS=true
MELO_AUTH_SECRET=replace-with-a-long-random-secret
QDRANT_API_KEY=
AGENT_ALLOWED_CAPABILITIES=file:read,code:analyze,document:search